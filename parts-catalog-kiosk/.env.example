# Settings → API Keys in Printago. Permissions needed: part.view, file.download, build.create, queue.view
PRINTAGO_API_KEY=

# Only show parts carrying this tag (set tags on a part in Printago). Leave empty to show every part.
CATALOG_TAG=
# Ask for a PIN before printing. Leave empty for no PIN.
KIOSK_PIN=
# Most copies one person can queue at once.
MAX_QUANTITY=10

# Optional
# PORT=3701
# HOST=127.0.0.1            # set 0.0.0.0 to reach it from a tablet on your network
# PRINTAGO_BASE_URL=https://api.printago.io
