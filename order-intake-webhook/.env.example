# Settings → API Keys in Printago. Permissions needed: order.view, order.create, order.print, queue.view
# (send-test-order also reads your SKUs: sku.view). Orders need a commercial Printago account.
PRINTAGO_API_KEY=

# Shared with the system that sends orders. It signs each request body with
# HMAC-SHA256 and sends `x-signature: sha256=<hex>`. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=

# Send new orders straight to the print queue. Set to false to review them in Printago first.
AUTO_PRINT=true

# Optional
# PORT=3702
# HOST=127.0.0.1            # set 0.0.0.0 (behind HTTPS) to receive webhooks from the internet
# PRINTAGO_BASE_URL=https://api.printago.io
