# Settings → API Keys in Printago. Permissions needed: printer.view, printer.stats, printer.camera
PRINTAGO_API_KEY=
# Shown on the API Keys page. It is also your MQTT username.
PRINTAGO_STORE_ID=

# Where to save images: OUTPUT_DIR/<printer>/<print>/<time>.jpg
OUTPUT_DIR=./snapshots
# Set to false to also keep the idle snapshots (one every ~10 minutes per printer).
ONLY_WHILE_PRINTING=true

# Optional
# PRINTAGO_BASE_URL=https://api.printago.io
# PRINTAGO_MQTT_URL=mqtts://realtime.printago.io:8883
