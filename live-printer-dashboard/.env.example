# Settings → API Keys in Printago. Permissions needed: printer.view, printer.stats
PRINTAGO_API_KEY=
# Shown on the API Keys page. It is also your MQTT username.
PRINTAGO_STORE_ID=

# Optional
# PORT=3700
# HOST=127.0.0.1            # set 0.0.0.0 to show it on a TV elsewhere on your network
# PRINTAGO_BASE_URL=https://api.printago.io
# PRINTAGO_MQTT_URL=mqtts://realtime.printago.io:8883
